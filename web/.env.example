# Copy to web/.env.local to override. All values are optional.

# Base URL of the backend API (default /api, which the dev server proxies to http://localhost:8000).
VITE_API_BASE=/api

# 1 = serve every call from the fixtures in src/mocks/ (same as `npm run dev:mock`).
VITE_MOCK=0

# Artificial latency for mock calls, in ms.
VITE_MOCK_DELAY=350
