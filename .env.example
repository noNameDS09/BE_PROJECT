# Copy to .env and fill in. .env is git-ignored; never commit keys.

# SEC EDGAR requires a contact in the User-Agent (requests without one get HTTP 403).
SEC_USER_AGENT="Loupe research project team-contact@example.edu"

# LLM providers (free tiers). Leave blank any provider you don't use.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
NVIDIA_NIM_API_KEY=
OLLAMA_API_BASE=http://localhost:11434
